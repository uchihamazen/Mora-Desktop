{
  "name": "mora-desktop",
  "productName": "Mora Desktop",
  "version": "0.13.0",
  "description": "Desktop chat for the installed Muse coding engine",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "smoke": "node scripts/smoke.js",
    "build": "node scripts/prepare-website-browser.js && electron-builder --win nsis --x64 --publish never --config.directories.output=artifacts/release",
    "build:desktop": "node scripts/prepare-website-browser.js && electron-builder --win --dir --x64 --config.directories.output=artifacts/self-build"
  },
  "devDependencies": {
    "electron": "44.5.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "local.muse.desktop",
    "artifactName": "Mora-Desktop-${version}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraFiles": [
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "artifacts/website-browser",
        "to": "website-browser",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/mora-mark.ico",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "Mora-Desktop-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Mora Desktop",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Mora-Desktop-Portable-${version}-${arch}.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
